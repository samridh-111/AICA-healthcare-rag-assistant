# ─── Backend (set in Render dashboard as secrets) ─────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_PATIENT_ID=patient_001

SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key
VECTOR_TABLE_NAME=clinical_knowledge

# Optional: authenticate HF API calls for higher embedding rate limits
HF_TOKEN=your_huggingface_token

# Optional: restrict CORS to your Vercel frontend (comma-separated list)
# Leave unset or "*" to allow all origins (suitable for local dev)
ALLOWED_ORIGINS=https://your-app.vercel.app

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# In PRODUCTION on Vercel: leave VITE_API_URL empty ("").
#   All /api/v1/* requests are proxied to Render via vercel.json rewrites.
# In LOCAL DEV: also leave empty — vite.config.js dev-server proxy handles it.
VITE_API_URL=
VITE_DEFAULT_PATIENT_ID=patient_001
